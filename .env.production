# Production Environment Configuration
NODE_ENV=production
PORT=6000
HOST=0.0.0.0

# Database Configuration (Update these for production)
DB_USER=your_prod_db_user
DB_PASSWORD=your_secure_prod_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sp_station_prod

# Security (Generate a strong secret for production)
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars

# Email Configuration (Update for production)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password

# Domain Configuration
DOMAIN=https://yourdomain.com