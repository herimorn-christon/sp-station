{
  "apps": [{
    "name": "sp-station-management",
    "script": "index.js",
    "instances": "max",
    "exec_mode": "cluster",
    "env": {
      "NODE_ENV": "production",
      "PORT": 6000
    },
    "env_production": {
      "NODE_ENV": "production",
      "PORT": 3000
    },
    "log_file": "./logs/combined.log",
    "out_file": "./logs/out.log",
    "error_file": "./logs/error.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "max_restarts": 10,
    "min_uptime": "10s",
    "max_memory_restart": "1G",
    "monitoring": true,
    "kill_timeout": 5000,
    "wait_ready": true,
    "listen_timeout": 10000,
    "watch": false,
    "ignore_watch": ["node_modules", "logs", "sp_frontend/dist"]
  }]
}