  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:ui": "npm run dev --prefix sp_frontend",
    "dev": "concurrently \"nodemon index.js\" \"npm run dev:ui\"",
    "build:ui": "npm run build --prefix sp_frontend",
    "build": "npm run build:ui",
    "start": "node index.js",
    "prod": "npm run build && pm2 start ecosystem.config.json --env production",
    "production": "npm run prod",
    "dev:pm2": "npm run build && pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 restart sp-station-management",
    "pm2:stop": "pm2 stop sp-station-management",
    "pm2:delete": "pm2 delete sp-station-management",
    "pm2:logs": "pm2 logs sp-station-management",
    "pm2:monit": "pm2 monit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.9"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.14.1",
    "twilio": "^5.5.2",
    "xlsx": "^0.18.5"
  }
